# Copy to .env and fill in values locally. Never commit .env.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Generate locally: /opt/homebrew/bin/python3.11 -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=
DB_PATH=./data/qwennote.db
# Comma-separated administrator IDs (union_id or open_id); whitespace and duplicate entries are ignored.
ADMIN_OPEN_ID=

# mcp reads rotating OAuth credentials from a file; legacy http remains for compatibility.
# Set fixture explicitly for an offline demo (no fallback).
QWENNOTE_SOURCE=mcp
QWENNOTE_MCP_URL=https://minutes.qwennote.cn/mcp
QWENNOTE_TOKEN_FILE=/opt/qwennote/data/mcp_token.json
# Legacy http only; unused by mcp.
QWENNOTE_MCP_TOKEN=
QWENNOTE_FIXTURE_DIR=./tests/fixtures/minutes
# MCP window begins at Shanghai midnight 90 days ago and ends now.
BACKFILL_DAYS=90

# Optional meeting tags; production secrets are loaded by systemd from
# /etc/claude/deepseek.qwennote.env. Never commit a real token.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
