[Unit]
Description=QwenNote SQLite online backup (latest seven dates)

[Service]
Type=oneshot
User=qwennote
Group=qwennote
WorkingDirectory=/opt/qwennote/current
Environment=PATH=/opt/qwennote/current/.sqlite/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/qwennote/current/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qwennote/data /opt/qwennote/backups
StandardOutput=journal
StandardError=journal
